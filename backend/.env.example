# Copy to .env and adjust for your environment.
# Everything below has a safe development default; never commit real secrets.

APP_NAME=SoilingGuard API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Database (SQLite fallback; use PostgreSQL in production)
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/soilingguard
DATABASE_URL=sqlite:///./soilingguard.db

# Security - generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Seed account (single user - the frontend signs itself in automatically)
SEED_RAMNATH_USERNAME=Ramnath
SEED_RAMNATH_PASSWORD=Ramnath

# Demo / simulation
DEMO_MODE=true
SIMULATOR_ENABLED=true
SIMULATOR_TICK_S=30
SEED_HISTORY_DAYS=7

# AI model (weights are NOT bundled; without them predictions run in demo mode)
MODEL_PATH=./models/soiling_mobilenetv3.pt
MODEL_METADATA_PATH=./models/model_metadata.json
MAX_UPLOAD_MB=8
GRADCAM_ENABLED=true

# Storage
MEDIA_DIR=./media

# MQTT (optional - leave MQTT_ENABLED=false without a broker)
MQTT_ENABLED=false
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=soilingguard

# Rate limits
LOGIN_RATE_LIMIT_PER_MINUTE=10
PREDICT_RATE_LIMIT_PER_MINUTE=12
CLEANING_RATE_LIMIT_PER_MINUTE=6
